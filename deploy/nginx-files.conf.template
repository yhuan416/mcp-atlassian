server {
    listen 8790;
    server_name _;
    root /data;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    # 禁止嗅探；日志类附件强制下载而不是内联
    add_header X-Content-Type-Options nosniff always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        # 令牌校验（由 compose 注入 FILES_TOKEN，nginx 官方镜像会做 envsubst）
        if ($http_x_files_token != "${FILES_TOKEN}") {
            return 401;
        }
        # 大文件：放开缓冲，避免落盘抖动
        sendfile on;
        tcp_nopush on;
    }
}